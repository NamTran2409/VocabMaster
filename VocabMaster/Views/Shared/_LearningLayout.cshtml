@{
    Layout = null;

    var pageTitle = ViewBag.Title ?? "Learning Space";

    var displayName = Convert.ToString(
        Session["FullName"] ??
        Session["UserEmail"] ??
        "Học viên"
    );

    var initials = string.IsNullOrWhiteSpace(displayName)
        ? "HV"
        : displayName.Substring(0, 1).ToUpperInvariant();

    var avatarUrl = Convert.ToString(Session["AvatarUrl"]);

    var dailyGoal = Convert.ToInt32(Session["DailyGoal"] ?? 10);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@pageTitle - VocabMaster</title>

    <link href="@Url.Content("~/Content/Learning.css?v=5")"
          rel="stylesheet" />
</head>

<body class="learning-body">

    <div class="app-shell">

        <!-- ================= SIDEBAR ================= -->
        <aside class="sidebar">

            <!-- LOGO -->
            <a class="brand"
               href="@Url.Action("Index", "Dashboard")">

                <span class="brand-mark">V</span>

                <span>
                    <b>VocabMaster</b>
                    <small>English Vocabulary Learning</small>
                </span>

            </a>

            <!-- SIDEBAR TITLE -->
            <div class="side-caption">
                LEARNING SPACE
            </div>

            <!-- MENU -->
            <nav class="side-nav">

                <!-- DASHBOARD -->
                <a href="@Url.Action("Index", "Dashboard")">
                    <span>▦</span>
                    Tổng quan
                </a>

                <!-- TOPICS -->
                <a href="@Url.Action("Index", "Topics")">
                    <span>▤</span>
                    Chủ đề
                </a>

                <!-- VOCABULARY -->
                <a class="@(ViewBag.Active == "VocabularyList" ? "active" : "")"
                   href="@Url.Action("VocabularyList", "Learning", new {
                        topicId = ViewBag.TopicId,
                        topicName = ViewBag.TopicName
                   })">
                    <span>☷</span>
                    Từ vựng
                </a>

                <!-- FLASHCARDS -->
                <a class="@(ViewBag.Active == "Flashcards" ? "active" : "")"
                   href="@Url.Action("Flashcards", "Learning", new {
                        topicId = ViewBag.TopicId,
                        topicName = ViewBag.TopicName
                   })">
                    <span>▣</span>
                    Flashcards
                </a>

                <!-- QUIZ -->
                <a href="@Url.Action("Index", "Quiz")">
                    <span>✓</span>
                    Quiz
                </a>

                <!-- PROGRESS -->
                <a class="@(ViewBag.Active == "Progress" ? "active" : "")"
                   href="@Url.Action("Index", "Progress")">
                    <span>▥</span>
                    My Progress
                </a>

                <!-- PROFILE -->
                <a class="@(ViewBag.Active == "Profile" ? "active" : "")"
                   href="@Url.Action("Index", "Profile")">
                    <span>◉</span>
                    Profile
                </a>

            </nav>

            <!-- ================= DAILY GOAL ================= -->
            <div class="daily-card">

                <div class="daily-icon">✦</div>

                <b>Mỗi ngày một bước nhỏ</b>

                <p>
                    Mục tiêu hôm nay: @dailyGoal từ mới.
                </p>

                <p>
                    Bạn đã học được 5 từ!
                </p>

                <div class="daily-progress">
                    <span></span>
                </div>

                <small>
                    5 / @dailyGoal từ hôm nay
                </small>

            </div>

            <!-- ================= SIDEBAR USER ================= -->
            <div class="user-mini">

                <div class="avatar">

                    @if (!String.IsNullOrWhiteSpace(avatarUrl))
                    {
                        <img src="@Url.Content(avatarUrl)"
                             alt="Avatar" />
                    }
                    else
                    {
                        @initials
                    }

                </div>

                <div>
                    <b>@displayName</b>
                    <small>Tài khoản học viên</small>
                </div>

            </div>

        </aside>


        <!-- ================= MAIN AREA ================= -->
        <main class="main-area">

            <!-- ================= TOPBAR ================= -->
            <header class="topbar">

                <div class="top-user">

                    <!-- DATE -->
                    <span class="top-date">
                        @DateTime.Now.ToString("dd/MM/yyyy")
                    </span>

                    <!-- ACCOUNT DROPDOWN -->
                    <div class="top-user-account">

                        <!-- AVATAR BUTTON -->
                        <button type="button"
                                class="avatar small account-toggle"
                                id="accountToggle"
                                aria-expanded="false"
                                aria-label="Mở menu tài khoản"
                                title="Tài khoản">

                            @if (!String.IsNullOrWhiteSpace(avatarUrl))
                            {
                                <img src="@Url.Content(avatarUrl)"
                                     alt="Avatar" />
                            }
                            else
                            {
                                @initials
                            }

                        </button>

                        <!-- DROPDOWN MENU -->
                        <div class="account-dropdown"
                             id="accountDropdown">

                            <!-- USER INFO -->
                            <div class="account-dropdown-info">

                                <strong>@displayName</strong>

                                <small>Tài khoản học viên</small>

                            </div>

                            <!-- DIVIDER -->
                            <div class="account-dropdown-divider"></div>

                            <!-- LOGOUT -->
                            <a href="@Url.Action("Logout", "Account")"
                               class="learning-logout">

                                <span>⇥</span>

                                <span>Đăng xuất</span>

                            </a>

                        </div>

                    </div>

                </div>

            </header>


            <!-- ================= PAGE CONTENT ================= -->
            <section class="page-content">
                @RenderBody()
            </section>


            <!-- ================= FOOTER ================= -->
            <footer class="page-footer">

                @displayName

                <span>
                    VocabMaster • Học từng từ, mở thêm cơ hội.
                </span>

            </footer>

        </main>

    </div>


    <!-- ================= ACCOUNT DROPDOWN SCRIPT ================= -->
    <script>document.addEventListener("DOMContentLoaded", function () {

            var toggle = document.getElementById("accountToggle");
            var dropdown = document.getElementById("accountDropdown");

            if (!toggle || !dropdown) return;

            // Bấm avatar để mở / đóng menu
            toggle.addEventListener("click", function (e) {

                e.stopPropagation();

                var isOpen = dropdown.classList.toggle("show");

                toggle.setAttribute("aria-expanded", isOpen);

            });

            // Bấm bên trong menu không đóng menu ngay
            dropdown.addEventListener("click", function (e) {

                e.stopPropagation();

            });

            // Bấm ra ngoài để đóng menu
            document.addEventListener("click", function () {

                dropdown.classList.remove("show");

                toggle.setAttribute("aria-expanded", "false");

            });

            // Nhấn Escape để đóng menu
            document.addEventListener("keydown", function (e) {

                if (e.key === "Escape") {

                    dropdown.classList.remove("show");

                    toggle.setAttribute("aria-expanded", "false");

                }

            });

        });</script>

    @RenderSection("scripts", required: false)

</body>
</html>