@{
    Layout = "~/Views/Account/_AuthLayout.cshtml";
    ViewBag.Title = "Quên mật khẩu";
}
<div class="forgot-wrap">
    <a class="brand dark-brand" href="@Url.Action("Index","Home")"><span class="brand-mark">V</span><span>VocabMaster<small>English Vocabulary Learning</small></span></a>
    <section class="forgot-card">
        <span class="eyebrow">KHÔI PHỤC TÀI KHOẢN</span>
        <h2>Quên mật khẩu?</h2>
        <p class="muted">Nhập email tài khoản của bạn để nhận liên kết tạo mật khẩu mới.</p>

        @if (ViewBag.Message != null) { <div class="alert info">@ViewBag.Message</div> }
        @if (ViewBag.Error != null) { <div class="alert danger">@ViewBag.Error</div> }

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "auth-form" }))
        {
            @Html.AntiForgeryToken()
            <label for="email">Email</label>
            <input id="email" name="email" type="email" placeholder="email@example.com" value="@ViewBag.Email" required />
            <button class="primary-btn" type="submit">Gửi liên kết đặt lại mật khẩu</button>
        }
        <p class="bottom-link"><a href="@Url.Action("Login")">← Quay lại đăng nhập</a></p>
    </section>
</div>
