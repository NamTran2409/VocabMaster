
@{
    Layout = "~/Views/Account/_AuthLayout.cshtml";
    ViewBag.Title = "Tạo mật khẩu mới";
}

<div class="forgot-wrap">
    <a class="brand dark-brand" href="@Url.Action("Index", "Home")">
        <span class="brand-mark">V</span>
        <span>
            VocabMaster
            <small>English Vocabulary Learning</small>
        </span>
    </a>

    <section class="forgot-card">
        <span class="eyebrow">KHÔI PHỤC TÀI KHOẢN</span>
        <h2>Tạo mật khẩu mới</h2>

        @if (ViewBag.Success != null)
        {
            <div class="alert info">
                @ViewBag.Success
            </div>

            <p class="bottom-link">
                <a href="@Url.Action("Login", "Account")">
                    ← Đăng nhập ngay
                </a>
            </p>
        }
        else if (ViewBag.Error != null &&
                 ViewBag.Token == null)
        {
            <div class="alert danger">
                @ViewBag.Error
            </div>

            <p class="bottom-link">
                <a href="@Url.Action("ForgotPassword", "Account")">
                    Yêu cầu liên kết mới
                </a>
            </p>
        }
        else
        {
            <p class="muted">
                Tài khoản: @ViewBag.Email
            </p>

            if (ViewBag.Error != null)
            {
                <div class="alert danger">
                    @ViewBag.Error
                </div>
            }

            <form action="@Url.Action("ResetPassword", "Account")"
                  method="post"
                  class="auth-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="token"
                       value="@ViewBag.Token" />

                <label for="password">Mật khẩu mới</label>

                <input id="password"
                       name="password"
                       type="password"
                       minlength="8"
                       autocomplete="new-password"
                       required />

                <small>Ít nhất 8 ký tự, gồm chữ và số.</small>

                <label for="confirmPassword">
                    Xác nhận mật khẩu mới
                </label>

                <input id="confirmPassword"
                       name="confirmPassword"
                       type="password"
                       minlength="8"
                       autocomplete="new-password"
                       required />

                <button class="primary-btn" type="submit">
                    Lưu mật khẩu mới
                </button>
            </form>
        }

        <p class="bottom-link">
            <a href="@Url.Action("Login", "Account")">
                ← Quay lại đăng nhập
            </a>
        </p>
    </section>
</div>
