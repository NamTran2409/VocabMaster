@{
    Layout = null;
    ViewBag.Title = "Đăng nhập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - VocabMaster</title>
    <link href="@Url.Content("~/Content/auth.css")" rel="stylesheet" />
</head>
<body>
    <div class="auth-shell">
        <aside class="auth-brand">
            <a class="brand" href="@Url.Action("Index", "Home")">
                <span class="brand-mark">V</span>
                <span>VocabMaster<small>English Vocabulary Learning</small></span>
            </a>

            <div class="brand-copy">
                <span class="eyebrow">YOUR NEXT CHAPTER</span>
                <h1>Từng từ mới.<br />Thêm một cơ hội.</h1>
                <p>Một không gian học từ vựng dành cho sinh viên: học theo chủ đề, ghi nhớ bằng flashcards và tự tin qua từng bài quiz.</p>

                <div class="study-art" aria-hidden="true">
                    <span class="book">▤</span>
                    <span class="globe">◎</span>
                    <span class="paper">➤</span>
                </div>

                <div class="stats">
                    <div><b>12</b><span>Chủ đề gần gũi</span></div>
                    <div><b>600</b><span>Từ vựng thực tế</span></div>
                    <div><b>3</b><span>Cách học linh hoạt</span></div>
                </div>
            </div>

            <p class="brand-foot">Học theo nhịp của bạn. Tiến bộ mỗi ngày.</p>
        </aside>

        <main class="auth-main">
            <div class="top-link">
                Chưa có tài khoản?
                <a href="@Url.Action("Register", "Account")">Tạo tài khoản →</a>
            </div>

            <section class="auth-card">
                <span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span>
                <h2>Đăng nhập</h2>
                <p class="muted">Tiếp tục hành trình từ vựng của bạn hôm nay.</p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert error">@ViewBag.Error</div>
                }

                <button class="google-btn" type="button"
                        onclick="alert('Đăng nhập Google chưa được cấu hình trong bản demo.')">
                    ◎ &nbsp; Tiếp tục với Google
                </button>

                <div class="separator">
                    <span>hoặc đăng nhập bằng email</span>
                </div>

                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "auth-form" }))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <label for="email">Email</label>
                    <input id="email" name="email" type="email"
                           autocomplete="email"
                           placeholder="minhanh@example.com"
                           value="@ViewBag.Email" required />

                    <label for="password">Mật khẩu</label>

                    <div class="password-field">
                        <input id="password"
                               name="password"
                               type="password"
                               autocomplete="current-password"
                               placeholder="Nhập mật khẩu"
                               required />

                        <button type="button"
                                class="password-toggle"
                                id="togglePassword"
                                aria-label="Hiển thị mật khẩu"
                                title="Hiển thị mật khẩu">

                            <!-- Mắt mở -->
                            <svg class="eye-open" viewBox="0 0 24 24" fill="none">
                                <path d="M2 12C4.2 7.8 7.6 5.5 12 5.5S19.8 7.8 22 12C19.8 16.2 16.4 18.5 12 18.5S4.2 16.2 2 12Z"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />
                                <circle cx="12" cy="12" r="3"
                                        stroke="currentColor"
                                        stroke-width="1.8" />
                            </svg>

                            <!-- Mắt đóng -->
                            <svg class="eye-closed" viewBox="0 0 24 24" fill="none">
                                <path d="M3 3L21 21"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round" />
                                <path d="M10 10A2.8 2.8 0 0 0 14 14"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round" />
                                <path d="M9.2 5.8C10.1 5.5 11 5.3 12 5.3C16.4 5.3 19.8 7.8 22 12C21.4 13.2 20.6 14.3 19.6 15.2"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round" />
                                <path d="M6.2 6.8C4.5 8.1 3.1 9.8 2 12C4.2 16.2 7.6 18.7 12 18.7C13.5 18.7 14.8 18.4 16 17.8"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round" />
                            </svg>
                        </button>
                    </div>

                    <div class="form-row">
                        <label class="check">
                            <input type="checkbox" name="rememberMe" value="true"
                                   @(ViewBag.RememberMe == true ? "checked" : "") />
                            Ghi nhớ đăng nhập
                        </label>

                        <a href="@Url.Action("ForgotPassword", "Account")">Quên mật khẩu?</a>
                    </div>

                    <button class="primary-btn" type="submit">
                        → &nbsp; Đăng nhập
                    </button>
                }

                <p class="bottom-link">
                    Chưa có tài khoản?
                    <a href="@Url.Action("Register", "Account")">Tạo tài khoản</a>
                </p>

                <div class="security-note">
                    Tài khoản học viên giúp lưu từ đã học và theo dõi tiến bộ của riêng bạn.
                </div>
            </section>

            <footer>© 2026 VocabMaster • English Vocabulary Learning</footer>
        </main>
    </div>

    <script>
        (function () {
            var toggleButton = document.getElementById("togglePassword");
            var passwordInput = document.getElementById("password");

            if (!toggleButton || !passwordInput) return;

            toggleButton.addEventListener("click", function () {
                var isPassword = passwordInput.type === "password";

                passwordInput.type = isPassword ? "text" : "password";

                this.classList.toggle("is-visible", isPassword);

                this.setAttribute(
                    "aria-label",
                    isPassword ? "Ẩn mật khẩu" : "Hiển thị mật khẩu"
                );

                this.setAttribute(
                    "title",
                    isPassword ? "Ẩn mật khẩu" : "Hiển thị mật khẩu"
                );
            });
        })();
    </script>
</body>
</html>
