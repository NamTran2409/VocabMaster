@{
    Layout = "~/Views/Account/_AuthLayout.cshtml";
    ViewBag.Title = "Đăng nhập";
}
<div class="auth-shell">
    <aside class="auth-brand">
        <a class="brand" href="@Url.Action("Index","Home")"><span class="brand-mark">V</span><span>VocabMaster<small>English Vocabulary Learning</small></span></a>
        <div class="brand-copy">
            <span class="eyebrow">YOUR NEXT CHAPTER</span>
            <h1>Từng từ mới.<br />Thêm một cơ hội.</h1>
            <p>Một không gian học từ vựng dành cho sinh viên: học theo chủ đề, ghi nhớ bằng flashcards và tự tin qua từng bài quiz.</p>
            <div class="study-art" aria-hidden="true"><span class="book">▤</span><span class="globe">◎</span><span class="paper">➤</span></div>
            <div class="stats"><div><b>12</b><span>Chủ đề gần gũi</span></div><div><b>600</b><span>Từ vựng thực tế</span></div><div><b>3</b><span>Cách học linh hoạt</span></div></div>
        </div>
        <p class="brand-foot">Học theo nhịp của bạn. Tiến bộ mỗi ngày.</p>
    </aside>
    <main class="auth-main">
        <div class="top-link">Chưa có tài khoản? <a href="@Url.Action("Register")">Tạo tài khoản →</a></div>
        <section class="auth-card">
            <span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span>
            <h2>Đăng nhập</h2>
            <p class="muted">Tiếp tục hành trình từ vựng của bạn hôm nay.</p>
            @if (ViewBag.Error != null) { <div class="alert error">@ViewBag.Error</div> }
            <button class="google-btn" type="button" onclick="alert('Đăng nhập Google chưa được cấu hình trong bản demo.')">◎ &nbsp; Tiếp tục với Google</button>
            <div class="separator"><span>hoặc đăng nhập bằng email</span></div>
            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "auth-form" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" placeholder="minhanh@example.com" value="@ViewBag.Email" required />
                <label for="password">Mật khẩu</label>
                <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required />
                <div class="form-row"><label class="check"><input type="checkbox" name="rememberMe" value="true" @(ViewBag.RememberMe == true ? "checked" : "") /> Ghi nhớ đăng nhập</label><a href="@Url.Action("ForgotPassword")">Quên mật khẩu?</a></div>
                <button class="primary-btn" type="submit">→ &nbsp; Đăng nhập</button>
            }
            <p class="bottom-link">Chưa có tài khoản? <a href="@Url.Action("Register")">Tạo tài khoản</a></p>
            <div class="security-note">Tài khoản học viên giúp lưu từ đã học và theo dõi tiến bộ của riêng bạn.</div>
        </section>
        <footer>© 2026 VocabMaster • English Vocabulary Learning</footer>
    </main>
</div>
